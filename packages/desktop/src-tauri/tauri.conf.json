{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vasta",
  "version": "0.3.1",
  "identifier": "io.github.ariedotme.vasta",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "node scripts/bundle-server.mjs --skip-web",
    "beforeBuildCommand": "node scripts/bundle-server.mjs"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src https: http:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "category": "Productivity",
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "server/": "server/"
    },
    "shortDescription": "Notes, captures and daily notes",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "vasta"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5Q0YwRkMyMUNFMkUwMTIKUldRUzRPSWN3Zy9QS2RqWHdjblozblNOTUtBdkZxdmF2ZXhwMnpCaXQ1bE5WZmdaNVA4UW1jbFEK",
      "endpoints": []
    }
  }
}
