# Copy to .env (used by `pnpm dev`) or .env.test (used by scripts/test-env.sh) and fill in.

# Day boundaries for captures, for accounts without their own time zone (IANA name, e.g.
# Europe/Lisbon). Defaults to the machine's zone, which is UTC in Docker.
VASTA_TIMEZONE=

# Accounts: the first one is created in the web app with the setup code the server logs; others
# join with invite links from Settings › Server accounts (docs/accounts.md). Capture channels use
# per-user tokens from Settings › Capture tokens or `pnpm vasta token add <username> <name>`.
# Legacy single capture token, capturing as the oldest user (optional).
VASTA_CAPTURE_TOKEN=

# Where the web app is reachable, for links in bot replies and reminders: in development
# http://127.0.0.1:5173, with Docker http://127.0.0.1:5174 or your HTTPS address.
# Reminders (Settings › Reminders: ntfy and Telegram) run unless VASTA_REMINDERS=0.
VASTA_WEB_URL=http://127.0.0.1:5173

# Saved links: set to 0 to stop fetching their pages (titles, preview images, readable text), or
# VASTA_CAPTURE_READABLE=0 to only skip saving a readable copy of every captured page.
# VASTA_FETCH_LINK_META=0
# VASTA_CAPTURE_READABLE=0

# Links and calendars on the local network are refused (so accounts cannot reach the LAN through
# the server). Allow some hosts, e.g. a Nextcloud calendar or an ntfy server for reminders, or 1 for
# everything.
# VASTA_ALLOW_PRIVATE_FETCH=cloud.lan,192.168.1.20

# Media (uploads, captured files, link previews) live in <data>/media unless an S3-compatible
# bucket is set (Garage, MinIO, Cloudflare R2, Backblaze B2, AWS S3; docs/deploy.md). Path-style
# addressing (endpoint/bucket/key) is the default; VASTA_S3_PATH_STYLE=0 puts the bucket in the host
# name. VASTA_S3_PREFIX optionally prefixes every key. Move existing files with `pnpm vasta media push`.
# VASTA_S3_ENDPOINT=http://garage:3900
# VASTA_S3_BUCKET=vasta-media
# VASTA_S3_REGION=garage
# VASTA_S3_ACCESS_KEY_ID=
# VASTA_S3_SECRET_ACCESS_KEY=
# VASTA_S3_PATH_STYLE=0
# VASTA_S3_PREFIX=

# Telegram: create a bot with @BotFather and paste its token. Then message the bot once: while
# nobody is linked it only replies with your user id; link it with
# `pnpm vasta user telegram <username> <id>`. Optional: TELEGRAM_ALLOWED_CHAT_IDS limits the chats
# it listens in; TELEGRAM_ALLOWED_USER_IDS (legacy) captures as the oldest user.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
